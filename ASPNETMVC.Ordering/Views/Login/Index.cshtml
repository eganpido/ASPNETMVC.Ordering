@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var terminals = ViewBag.Terminals as IEnumerable<dynamic>;
}
<div class="container d-flex align-items-center justify-content-center px-3" style="min-height: 80vh;">
    <div class="row w-100 justify-content-center">
        <!-- Gi-adjust ang responsive column sizes aron dako-dako ang espasyo sa tablet portrait -->
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-4">

            <!-- Login Card Container -->
            <div class="card shadow-lg border-0" style="border-radius: 20px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
                <div class="card-body p-4 p-sm-5">

                    <!-- Header Logo / Title Area -->
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center shadow-sm mb-3 rounded-circle" style="width: 70px; height: 70px; background: rgba(0, 138, 178, 0.1);">
                            <img src="~/Content/Images/liteclerklogoimg.png" alt="Liteclerk Icon" style="width: 40px; height: 40px; object-fit: contain;" />
                        </div>
                        <p class="text-muted small">Sign in to access to start the order</p>
                    </div>

                    <!-- Using Html.BeginForm for ASP.NET MVC Controller Action -->
                    @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { @class = "needs-validation", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                        <!-- Username Field -->
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">USERNAME</label>
                            <div class="input-group shadow-sm" style="border-radius: 12px;">
                                <span class="input-group-text bg-light border-end-0 px-3" style="border-radius: 12px 0 0 12px; border-color: #cbd5e1;">
                                    <img src="@Url.Content("~/Content/Images/username.png")" alt="User" style="width: 20px; height: 20px; object-fit: contain;" />
                                </span>
                                <input type="text" name="Username" class="form-control bg-light border-start-0 py-2.5" placeholder="e.g. staff01" required autofocus style="border-radius: 0 12px 12px 0; border-color: #cbd5e1; box-shadow: none; font-size: 0.92rem;" />
                            </div>
                        </div>

                        <!-- Password Field -->
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">PASSWORD</label>
                            <div class="input-group shadow-sm" style="border-radius: 12px;">
                                <span class="input-group-text bg-light border-end-0 px-3" style="border-radius: 12px 0 0 12px; border-color: #cbd5e1;">
                                    <img src="@Url.Content("~/Content/Images/password.png")" alt="Password" style="width: 20px; height: 20px; object-fit: contain;" />
                                </span>
                                <input type="password" name="Password" class="form-control bg-light border-start-0 py-2.5" placeholder="••••••••" required style="border-radius: 0 12px 12px 0; border-color: #cbd5e1; box-shadow: none; font-size: 0.92rem;" />
                            </div>
                        </div>

                        <!-- Terminal Selection Field -->
                        <div class="mb-4">
                            <label class="form-label text-secondary small fw-bold">TERMINAL</label>
                            <div class="input-group shadow-sm" style="border-radius: 12px;">
                                <span class="input-group-text bg-light border-end-0 px-3" style="border-radius: 12px 0 0 12px; border-color: #cbd5e1;">
                                    <img src="@Url.Content("~/Content/Images/terminal.png")" alt="Terminal" style="width: 20px; height: 20px; object-fit: contain;" />
                                </span>
                                <select name="TerminalId" class="form-select bg-light border-start-0 py-2.5" required style="border-radius: 0 12px 12px 0; border-color: #cbd5e1; box-shadow: none; font-size: 0.92rem;">
                                    <option value="" disabled selected>-- Select Terminal --</option>
                                    @if (terminals != null)
                                    {
                                        foreach (var terminal in terminals)
                                        {
                                            <option value="@terminal.Id" @(terminal.Id == 1 ? "selected" : "")>@terminal.Terminal</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn text-white fw-bold py-3 shadow-sm d-inline-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #008AB2 0%, #006080 100%); border-radius: 12px; transition: all 0.2s ease-in-out; font-size: 0.95rem;">
                                <i class="fa-solid fa-right-to-bracket me-2"></i> Sign-in to Terminal
                            </button>
                        </div>
                    }

                    <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-center gap-2 mt-4 pt-3 border-top border-light">
                        <!-- Back to Home Link -->
                        <a href="@Url.Action("Index", "Home")" class="text-decoration-none small fw-semibold back-home-link d-inline-flex align-items-center" style="font-size: 0.75rem; color: #dc3545;">
                            <span class="transition-icon me-1">&larr;</span> Back to Home
                        </a>

                        <!-- DB Status Connected Badge -->
                        <div class="d-flex align-items-center">
                            <span class="db-badge shadow-sm px-3 py-1.5 rounded-pill text-success" style="background-color: rgba(115, 194, 62, 0.12); font-weight: 600; font-size: 0.75rem;">
                                <i class="fa-solid fa-circle-check me-2"></i> DB Status : Connected
                            </span>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- Extra styling adjustment for button hover & select focus -->
<style>
    .btn:hover {
        opacity: 0.92;
        transform: translateY(-1px);
    }

    .form-control:focus, .form-select:focus {
        background-color: #ffffff !important;
        border-color: var(--pos-blue, #008AB2) !important;
        box-shadow: 0 0 0 3px rgba(0, 138, 178, 0.15) !important;
    }
</style>