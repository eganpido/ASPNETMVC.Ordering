@{
    ViewBag.Title = "Table Selection";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var tableGroups = ViewBag.TableGroups as IEnumerable<dynamic>;
    var tables = ViewBag.Tables as IEnumerable<ASPNETMVC.Ordering.Models.TableStatusModel>;
}

<div class="container py-4">
    <!-- TOP INFO BAR: Terminal & Staff User (Naa sa pinakataas) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center bg-white px-3 py-2 rounded-3 shadow-sm mb-3 border-0">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <!-- Terminal Badge -->
            <div class="d-flex align-items-center text-secondary small fw-semibold">
                <i class="fa-solid fa-desktop me-2" style="color: #008AB2;"></i>
                <span>Terminal:</span>
                <strong class="text-dark ms-1">@(Session["Terminal"] ?? "Unknown")</strong>
            </div>
            <span class="text-muted d-none d-sm-inline">|</span>
            <!-- Staff / Cashier User Badge -->
            <div class="d-flex align-items-center text-secondary small fw-semibold">
                <i class="fa-solid fa-user-tie me-2" style="color: #73C23E;"></i>
                <span>Staff:</span>
                <strong class="text-dark ms-1">@(Session["StaffUser"] ?? "Unknown")</strong>
            </div>
        </div>

        <!-- Status Badge -->
        <div class="d-flex align-items-center">
            <span class="badge rounded-pill px-2.5 py-1 text-success" style="background-color: rgba(115, 194, 62, 0.12); font-size: 0.7rem; font-weight: 700;">
                <i class="fa-solid fa-circle fa-2xs me-1"></i> DB Status : Connected
            </span>
        </div>
    </div>

    <!-- MAIN HEADER: Title, Live Clock, & Sign-out -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-extrabold text-dark mb-1" style="letter-spacing: -1px;">
                <span style="color: #008AB2;">Table</span> Ordering
            </h2>
            <p class="text-muted small mb-0">Select a table group to view available tables and start ordering.</p>
        </div>

        <!-- Right side: Live Date/Time & Sign-out button -->
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <!-- Live Date & Time Display -->
            <div class="text-dark fw-bold px-3 py-1.5 bg-white shadow-sm rounded-pill border d-flex align-items-center" style="font-size: 1.05rem;">
                <i class="fa-regular fa-clock me-2" style="color: #008AB2; font-size: 1.05rem;"></i>
                <span id="liveDateTime">Loading...</span>
            </div>

            <!-- Sign-out Button -->
            <a href="@Url.Action("SignOut", "Login")" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold text-nowrap shadow-sm">
                <i class="fa-solid fa-right-from-bracket me-1"></i> Sign out
            </a>
        </div>
    </div>

    <!-- Table Group Navigation Pills (Logo Inspired Colors) -->
    <div class="mb-4">
        <div class="d-flex flex-wrap gap-2" id="tableGroupTabs">
            <!-- "All Tables" Default Button -->
            <button type="button" class="btn group-tab-btn active px-4 py-2 rounded-pill fw-semibold shadow-sm" data-group="all" style="background-color: #008AB2; color: white; border: none; transition: all 0.2s;">
                <i class="fa-solid fa-border-all me-1"></i> All Tables
            </button>

            @if (tableGroups != null)
            {
                foreach (var group in tableGroups)
                {
                    <!-- Gikuha ang bg-white text-dark border aron dili mo-block sa styling -->
                    <button type="button" class="btn group-tab-btn px-4 py-2 rounded-pill fw-semibold shadow-sm" data-group="@group.Id" style="background-color: #ffffff; color: #212529; border: 1px solid #dee2e6; transition: all 0.2s;">
                        @group.TableGroup
                    </button>
                }
            }
        </div>
    </div>

    <!-- Tables Grid Container -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="tablesContainer">
        @if (tables != null && tables.Any())
        {
            foreach (var table in tables)
            {
                // Gigamit na ang tinuod nga calculated status gikan sa Controller
                bool isOccupied = table.IsOccupied;

                <div class="col table-card-item" data-groupid="@table.TableGroupId">
                    <div class="card h-100 shadow-sm border-0 table-card" style="border-radius: 16px; transition: transform 0.2s, box-shadow 0.2s; background: #ffffff;">
                        <div class="card-body text-center p-4 d-flex flex-column justify-content-between">

                            <!-- Top Status Badge -->
                            <div class="d-flex justify-content-between align-items-center w-100 mb-3">
                                <span class="badge rounded-pill px-2.5 py-1" style="background-color: @(isOccupied ? "rgba(220, 53, 69, 0.1)" : "rgba(115, 194, 62, 0.15)"); color: @(isOccupied ? "#dc3545" : "#5a9e30"); font-size: 0.7rem; font-weight: 700;">
                                    <i class="fa-solid fa-circle fa-2xs me-1"></i> @(isOccupied ? "Not Available" : "Available")
                                </span>
                                <span class="text-muted small fw-bold">#@table.Id</span>
                            </div>

                            <!-- Table Icon / Name (Naay dako nga image) -->
                            <div class="my-3">
                                <div class="mx-auto rounded-circle d-flex align-items-center justify-content-center shadow-inner mb-3" style="width: 110px; height: 110px; background: rgba(0, 138, 178, 0.08); ">
                                    <img src="@Url.Content(isOccupied ? "~/Content/Images/occupied.png" : "~/Content/Images/table.png")" alt="Table Icon" style="width: 80px; height: 80px; object-fit: contain; " />
                                </div>
                                <h4 class="fw-bold text-dark mb-1">@table.TableCode</h4>
                                <!--<p class="text-muted small mb-0">-->@*Capacity: 4 persons*@<!--</p>-->
                            </div>

                            <!-- Action Button -->
                            <div class="d-grid mt-3">
                                @if (isOccupied)
                                {
                                    <button type="button" class="btn btn-sm fw-bold text-white py-2 rounded-pill shadow-sm btn-occupied-alert" style="background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);" data-tablecode="@table.TableCode" data-tableid="@table.Id" data-salesid="@table.SalesId">
                                        View Active Order
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm fw-bold text-white py-2 rounded-pill shadow-sm btn-select-table" style="background: linear-gradient(135deg, #008AB2 0%, #006080 100%);" data-tablecode="@table.TableCode" data-tableid="@table.Id">
                                        Select Table
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-light rounded-4 border border-dashed">
                    <i class="fa-solid fa-utensils fa-3x text-muted mb-3"></i>
                    <h5 class="fw-bold text-dark">No Tables Found</h5>
                    <p class="text-muted small">Palihug i-setup ang imong mga Table Groups ug Tables sa database.</p>
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // 1. Live Clock Function
            function updateLiveClock() {
                const now = new Date();
                const options = {
                    weekday: 'short',
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                    hour12: true
                };
                $('#liveDateTime').text(now.toLocaleString('en-US', options));
            }

            updateLiveClock();
            setInterval(updateLiveClock, 1000);

            // 2. Table Group Tabs Filtering (Gamit ang delegated event aron mas luwas)
            $(document).on('click', '.group-tab-btn', function () {
                $('.group-tab-btn').removeClass('active shadow').css({
                    'background-color': '#ffffff',
                    'color': '#212529',
                    'border': '1px solid #dee2e6'
                });

                $(this).addClass('active shadow').css({
                    'background-color': '#008AB2',
                    'color': '#ffffff',
                    'border': 'none'
                });

                var selectedGroup = $(this).data('group');

                if (selectedGroup === 'all') {
                    $('.table-card-item').fadeIn(200);
                } else {
                    $('.table-card-item').hide();
                    $('.table-card-item[data-groupid="' + selectedGroup + '"]').fadeIn(200);
                }
            });

            // 3. Click handler para sa Available Tables (CreateNewSale una moadto sa OrderDetail)
            $(document).on('click', '.btn-select-table', function (e) {
                e.preventDefault();
                var tableCode = $(this).data('tablecode');
                var tableId = $(this).data('tableid');

                Swal.fire({
                    title: '<span style="color: #2c3e50; font-weight: 700;">Table ' + tableCode + '</span>',
                    html: '<p class="text-muted small">Would you like to start taking an order for this table?</p>',
                    icon: 'question',
                    iconColor: '#008AB2',
                    showCloseButton: true,
                    showCancelButton: false,
                    confirmButtonColor: '#73C23E',
                    confirmButtonText: '<i class="fa-solid fa-cart-plus me-1"></i> Take Order',
                    background: '#ffffff',
                    customClass: {
                        popup: 'rounded-4 shadow-lg border-0'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("CreateNewSale", "Order")',
                            type: 'POST',
                            data: { tableId: tableId },
                            success: function (response) {
                                if (response.success) {
                                    window.location.href = '@Url.Action("OrderDetail", "Order")?tableId=' + tableId + '&salesId=' + response.salesId;
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('Error', 'An error occurred while creating the sales record.', 'error');
                            }
                        });
                    }
                });
            });

            // 4. Click handler para sa Occupied Tables (View Order o Cancel Order)
            $(document).on('click', '.btn-occupied-alert', function (e) {
                e.preventDefault();
                var tableCode = $(this).data('tablecode');
                var tableId = $(this).data('tableid');
                var salesId = $(this).data('salesid');

                Swal.fire({
                    title: '<span style="color: #2c3e50; font-weight: 700;">Table ' + tableCode + ' is Occupied</span>',
                    html: '<p class="text-muted small mb-3">This table already has an active order. What would you like to do?</p>' +
                          '<div class="d-grid gap-2 px-4">' +
                          '  <button id="swalBtnView" class="btn text-white fw-bold py-2 rounded-pill shadow-sm" style="background-color: #008AB2;"><i class="fa-solid fa-eye me-1"></i> View Order</button>' +
                          '  <button id="swalBtnCancelOrder" class="btn btn-outline-danger fw-bold py-2 rounded-pill shadow-sm"><i class="fa-solid fa-ban me-1"></i> Cancel Order</button>' +
                          '</div>',
                    icon: 'warning',
                    iconColor: '#dc3545',
                    showCloseButton: true,
                    showConfirmButton: false,
                    showCancelButton: false,
                    background: '#ffffff',
                    customClass: {
                        popup: 'rounded-4 shadow-lg border-0'
                    }
                });

                // Event listener para sa "View Order" button sa sulod sa SweetAlert
                $(document).off('click', '#swalBtnView').on('click', '#swalBtnView', function () {
                    window.location.href = '@Url.Action("OrderDetail", "Order")?tableId=' + tableId + (salesId ? '&salesId=' + salesId : '');
                });

                // Event listener para sa "Cancel Order" button
                $(document).off('click', '#swalBtnCancelOrder').on('click', '#swalBtnCancelOrder', function () {
                    Swal.fire({
                        title: '<span style="color: #2c3e50; font-weight: 700;">Cancel This Order?</span>',
                        html: '<p class="text-muted small">Are you sure you want to cancel and delete the active order for Table ' + tableCode + '?</p>',
                        icon: 'warning',
                        iconColor: '#dc3545',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Yes, cancel order',
                        customClass: { popup: 'rounded-4 shadow-lg border-0' }
                    }).then((confirmResult) => {
                        if (confirmResult.isConfirmed) {
                            $.ajax({
                                url: '@Url.Action("CancelSale", "Order")',
                                type: 'POST',
                                data: { salesId: salesId },
                                success: function (response) {
                                    if (response.success) {
                                        Swal.fire({
                                            title: 'Cancelled!',
                                            text: response.message,
                                            icon: 'success',
                                            confirmButtonColor: '#73C23E',
                                            customClass: { popup: 'rounded-4 shadow-lg border-0' }
                                        }).then(() => {
                                            location.reload();
                                        });
                                    } else {
                                        Swal.fire('Error', response.message, 'error');
                                    }
                                },
                                error: function () {
                                    Swal.fire('Error', 'An error occurred while cancelling the order.', 'error');
                                }
                            });
                        }
                    });
                });
            });
        });
    </script>
}
<!-- Custom CSS para sa Hover Effects -->
<style>
    .table-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0, 138, 178, 0.12) !important;
        border-color: rgba(0, 138, 178, 0.3) !important;
    }
</style>